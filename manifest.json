{
  "manifest_version": 3,
  "name": "Glisters — New Tab",
  "description": "Minimal keyboard-first new tab with a shortcut grid, per-user sync via Clerk + Cloudflare.",
  "version": "1.0.0",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "bookmarks", "cookies"],
  "host_permissions": [
    "https://*/*",
    "https://*.clerk.accounts.dev/*",
    "https://morphica-nine.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src https: data: blob:; connect-src 'self' https:;"
  }
}