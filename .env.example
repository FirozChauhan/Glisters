# copy to .env, fill in, then run: node scripts/gen-config.mjs
# this regenerates js/config.js which the extension reads at runtime
#
# Deploy the sync worker first (cd worker && wrangler deploy), then paste its
# public URL here. The worker holds the R2 binding server-side, so the
# extension only ever talks to this URL — no R2 credentials ship with it.
R2_WORKER_URL=https://glisters.<your-subdomain>.workers.dev
# optional: wallhaven API key — unlocks the NSFW purity option (see README).
# Get one at https://wallhaven.cc/settings/account. Leave blank to keep NSFW
# disabled.
WALLHAVEN_API_KEY=
