# copy to .env, fill in, then run: node scripts/gen-config.mjs
# this regenerates js/config.js which the extension reads at runtime
#
# Deploy the sync worker first (cd worker && wrangler deploy), then paste its
# public URL here. The worker holds the R2 binding server-side, so the
# extension only ever talks to this URL — no R2 credentials ship with it.
R2_WORKER_URL=https://glisters.<your-subdomain>.workers.dev
# optional: wallhaven API key — unlocks the NSFW purity option (see README).
# Get one at https://wallhaven.cc/settings/account. Leave blank to keep NSFW
# disabled.
WALLHAVEN_API_KEY=

# --- Clerk auth (multi-user sync) -----------------------------------------
# Create an app at https://dashboard.clerk.com, then:
#   1. publishable key (pk_...) — public by design; regenerated into
#      js/config.js by gen-config.mjs. The extension uses it to start the
#      Clerk client (bundled by `npm run gen-auth`).
#   2. secret key (sk_...) — NEVER in .env for the extension; it belongs to
#      the worker: `cd worker && wrangler secret put CLERK_SECRET_KEY` (local
#      dev: worker/.dev.vars with CLERK_SECRET_KEY=sk_...).
#   3. Clerk Dashboard → your app → allowed origins must include
#      chrome-extension://<your-extension-id> (Settings → API Keys/Advanced).
CLERK_PUBLISHABLE_KEY=pk_test_...
+
+# Reachable Clerk frontend API (the publishable key embeds a dead vercel.app
+# subdomain that can't exist; ClerkJS routes all calls through this proxy).
+# Only needed when the Clerk instance uses a proxy/custom domain.
+CLERK_PROXY_URL=
